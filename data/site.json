    {
      "id": 3,
      "type": "program",
      "title": "Программа недели",
      "enabled": true,
      "data": {
        "title": "ПРОГРАММА НЕДЕЛИ ДИЗАЙНА",
        "html": "<p>Лекции, выставки, дискуссии, городские проекты и специальные мероприятия на ключевых площадках Ташкента.</p><p><strong>Семь дней, десятки событий и одна общая тема — как дизайн меняет город.</strong></p>",
        "linkText": "Смотреть полную программу →",
        "translations": {
          "uz": {
            "title": "DIZAYN HAFTALIGI DASTURI",
            "html": "<p>Toshkentning asosiy maydonlarida ma‘ruzalar, ko‘rgazmalar, munozaralar, shahar loyihalari va maxsus tadbirlar.</p><p><strong>Yetti kun, o‘nlab tadbirlar va bitta umumiy mavzu — dizayn shaharni qanday o‘zgartiradi.</strong></p>",
            "linkText": "To‘liq dasturni ko‘rish →"
          },
          "en": {
            "title": "DESIGN WEEK PROGRAM",
            "html": "<p>Lectures, exhibitions, panel discussions, urban projects, and special events across key venues in Tashkent.</p><p><strong>Seven days, dozens of events, and one central theme — how design transforms the city.</strong></p>",
            "linkText": "View full schedule →"
          }
        },
        "linkUrl": "#events"
      }
    },
