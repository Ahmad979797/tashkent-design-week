<section id="<%= id %>" class="panel collection"><div class="panel-head"><div><div class="eyebrow">CONTENT</div><h2><%= title %></h2></div></div><div class="collection-grid"><% items.forEach(item=>{ %><form method="post" action="/admin/<%= type %>/save" class="item-card"><input type="hidden" name="id" value="<%= item.id %>"><div class="item-top"><b>#<%= item.id %></b><button type="submit">Сохранить</button></div><% fields.forEach(f=>{ %><label><%= f[1] %><% if(f[0]==='description'||f[0]==='bio'){ %><textarea name="<%= f[0] %>" rows="3"><%= item[f[0]]||'' %></textarea><% } else { %><input name="<%= f[0] %>" value="<%= item[f[0]]||'' %>"><% } %></label><% }) %><label class="switch"><input type="checkbox" name="enabled" value="1" <%= item.enabled?'checked':'' %>> Показывать</label><a class="danger-link" href="javascript:void(0)" onclick="deleteItem('<%= type %>',<%= item.id %>)">Удалить</a></form><% }) %></div><div class="new-item"><h3>Добавить новый</h3><form method="post" action="/admin/<%= type %>/save" class="grid-form"><% fields.forEach(f=>{ %><label><%= f[1] %><% if(f[0]==='description'||f[0]==='bio'){ %><textarea name="<%= f[0] %>" rows="3"></textarea><% } else { %><input name="<%= f[0] %>"><% } %></label><% }) %><label class="switch"><input type="checkbox" name="enabled" value="1" checked> Показывать</label><div><button>+ Добавить</button></div></form></div></section>
