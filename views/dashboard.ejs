<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CMS — Tashkent Design Week</title><link rel="stylesheet" href="/admin.css"></head><body>
<header class="admin-top"><div><b>TASHKENT DESIGN WEEK</b><span>CMS</span></div><div><a href="/" target="_blank">Открыть сайт ↗</a><form method="post" action="/admin/logout" style="display:inline"><button>Выйти</button></form></div></header>
<div class="admin-layout"><aside><a href="#page">Структура</a><a href="#settings">Настройки</a><a href="#events">Мероприятия</a><a href="#speakers">Спикеры</a><a href="#projects">Проекты</a><a href="#activations">City Activations</a><a href="#locations">Карта</a><a href="#registrations">Регистрации</a></aside><main class="admin-main">
<% if(message){ %><div class="notice"><%= message %></div><% } %>
<section id="page" class="panel"><div class="panel-head"><div><div class="eyebrow">PAGE BUILDER</div><h1>Структура страницы</h1><p>Перетаскивай блоки, включай/выключай и редактируй контент.</p></div><form method="post" action="/admin/blocks/add" class="add-form"><select name="type"><option value="text">Текст</option><option value="image">Изображение</option><option value="gallery">Галерея</option><option value="cta">CTA</option><option value="hero">Hero</option></select><button>+ Добавить блок</button></form></div><div id="block-list" class="block-list"><% blocks.forEach(b=>{ %><details class="block" draggable="true" data-id="<%= b.id %>"><summary><span class="drag">☷</span><strong><%= b.title||b.type %></strong><span class="tag"><%= b.type %></span><span class="status <%= b.enabled?'on':'off' %>"><%= b.enabled?'ON':'OFF' %></span></summary><div class="block-body"><form method="post" action="/admin/blocks/<%= b.id %>/save" class="editor"><input name="title" value="<%= b.title %>" placeholder="Название блока"><label class="switch"><input type="checkbox" name="enabled" value="1" <%= b.enabled?'checked':'' %>> Показывать</label><textarea name="data" rows="16"><%= JSON.stringify(b.data,null,2) %></textarea><small>Для основных системных блоков редактируй JSON полей. Ниже доступны готовые CRUD-формы для мероприятий, спикеров, проектов, активаций и карты.</small><div><button>Сохранить блок</button></div></form><form method="post" action="/admin/blocks/<%= b.id %>/delete" onsubmit="return confirm('Удалить блок?')"><button class="danger">Удалить</button></form></div></details><% }) %></div></section>
<section id="settings" class="panel"><div class="panel-head"><div><div class="eyebrow">GLOBAL STYLE</div><h2>Настройки сайта</h2></div></div><form method="post" action="/admin/settings" class="grid-form"><label>Название<input name="siteTitle" value="<%= settings.siteTitle %>"></label><label>Даты<input name="siteDates" value="<%= settings.siteDates %>"></label><label>Основной цвет<input name="primary" value="<%= settings.primary %>"></label><label>Акцент<input name="accent" value="<%= settings.accent %>"></label><label>Фон<input name="background" value="<%= settings.background %>"></label><label>Цвет текста<input name="text" value="<%= settings.text %>"></label><label>Основной шрифт<select name="font"><% ['Inter, Arial, sans-serif','Arial, Helvetica, sans-serif','Helvetica, Arial, sans-serif','Georgia, serif','Times New Roman, serif','Courier New, monospace'].forEach(f=>{ %><option <%= settings.font===f?'selected':'' %>><%= f %></option><% }) %></select></label><label>Display шрифт<select name="displayFont"><% ['Arial, Helvetica, sans-serif','Inter, Arial, sans-serif','Helvetica, Arial, sans-serif','Georgia, serif','Times New Roman, serif'].forEach(f=>{ %><option <%= settings.displayFont===f?'selected':'' %>><%= f %></option><% }) %></select></label><div><button>Сохранить настройки</button></div></form></section>
<%- include('collection', {id:'events',title:'Мероприятия',items:events,type:'events',fields:[['image','Изображение URL'],['title','Название'],['date','Дата'],['time','Время'],['location','Локация'],['description','Описание'],['link','Ссылка']]}) %>
<%- include('collection', {id:'speakers',title:'Спикеры',items:speakers,type:'speakers',fields:[['image','Изображение URL'],['name','Имя'],['role','Должность'],['company','Компания'],['country','Страна'],['bio','Биография'],['topic','Тема'],['link','Ссылка']]}) %>
<%- include('collection', {id:'projects',title:'Специальные проекты',items:projects,type:'projects',fields:[['image','Изображение URL'],['title','Название'],['category','Категория'],['description','Описание'],['participants','Участники'],['location','Локация'],['link','Ссылка']]}) %>
<%- include('collection', {id:'activations',title:'City Activations',items:activations,type:'activations',fields:[['image','Изображение URL'],['title','Название'],['date','Дата'],['time','Время'],['location','Локация'],['description','Описание'],['link','Ссылка']]}) %>
<%- include('collection', {id:'locations',title:'Локации карты',items:locations,type:'locations',fields:[['name','Название'],['address','Адрес'],['type','Тип'],['description','Описание'],['x','X %'],['y','Y %'],['link','Ссылка']]}) %>
<section id="registrations" class="panel"><div class="panel-head"><div><div class="eyebrow">LEADS</div><h2>Регистрации</h2></div><a class="button" href="/admin/registrations.csv">Экспорт CSV ↓</a></div><div class="table-wrap"><table><thead><tr><th>Имя</th><th>Телефон</th><th>Email</th><th>Компания</th><th>Должность</th><th>Интерес</th><th>Дата</th></tr></thead><tbody><% registrations.forEach(r=>{ %><tr><td><%= r.first_name %> <%= r.last_name %></td><td><%= r.phone %></td><td><%= r.email %></td><td><%= r.company %></td><td><%= r.role %></td><td><%= r.interest %></td><td><%= r.created_at %></td></tr><% }) %></tbody></table></div></section>
</main></div><script src="/admin.js"></script></body></html>
