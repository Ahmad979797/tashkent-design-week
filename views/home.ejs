<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= settings.siteTitle %></title><meta name="description" content="Tashkent Design Week — люди, пространства, идеи."><link rel="stylesheet" href="/style.css"></head>
<body style="--primary:<%= settings.primary %>;--accent:<%= settings.accent %>;--bg:<%= settings.background %>;--text:<%= settings.text %>;--font:<%= settings.font %>;--display:<%= settings.displayFont %>">
<header class="topbar"><a class="brand" href="#top"><%= settings.siteTitle %></a><nav><% JSON.parse(settings.nav||'[]').forEach((n,i)=>{const ids=['program','events','speakers','projects','activations','map']; %><a href="#<%= ids[i]||'registration' %>"><%= n %></a><%}) %></nav><a class="top-cta" href="#registration">Зарегистрироваться ↗</a><button class="menu" aria-label="Меню">☰</button></header>
<main id="top">
<% blocks.filter(b=>b.enabled).forEach(block=>{ const d=block.data; %>
<% if(block.type==='logos'){ %><section class="logos section"><div class="eyebrow"><%= d.eyebrow %></div><div class="logo-row"><% (d.logos||[]).forEach(l=>{ %><div class="logo-item"><% if(l.image){ %><img src="<%= l.image %>" alt="<%= l.name %>"><% } else { %><span><%= l.name %></span><% } %></div><% }) %></div></section>
<% } else if(block.type==='hero'){ %><section class="hero"><div class="hero-copy"><div class="eyebrow"><%= d.dates %></div><h1><%= d.title %></h1><p><%= d.subtitle %></p><a class="button" href="<%= d.buttonLink %>"><%= d.button %> <span>↗</span></a></div><div class="hero-image <%= d.image?'has-image':'' %>" style="<%= d.image?`background-image:url('${d.image}')`:'' %>"><% if(!d.image){ %><div class="image-placeholder">ARCHITECTURE / CITY / DESIGN</div><% } %></div></section>
<% } else if(block.type==='program'){ %><section class="section program" id="program"><div class="section-head"><h2><%= d.title %></h2></div><div class="program-grid"><div class="rich"><%- d.html %></div><a class="text-link" href="#events"><%= d.linkText %></a></div></section>
<% } else if(block.type==='events'){ %><section class="section" id="events"><div class="section-head"><h2><%= d.title %></h2><a href="#events">Все мероприятия →</a></div><div class="cards-slider"><% events.forEach(e=>{ %><article class="event-card"><div class="media" style="<%= e.image?`background-image:url('${e.image}')`:'' %>"><% if(!e.image){ %><span>EVENT / DESIGN / CITY</span><% } %></div><div class="meta"><%= e.date %> · <%= e.time %></div><h3><%= e.title %></h3><p><%= e.description %></p><small><%= e.location %></small></article><% }) %></div></section>
<% } else if(block.type==='speakers'){ %><section class="section" id="speakers"><div class="section-head"><h2><%= d.title %></h2><a href="#speakers">Все спикеры →</a></div><div class="speaker-grid"><% speakers.forEach(s=>{ %><article class="speaker"><div class="portrait" style="<%= s.image?`background-image:url('${s.image}')`:'' %>"><% if(!s.image){ %><span><%= s.name.split(' ').map(x=>x[0]).join('').slice(0,2) %></span><% } %></div><h3><%= s.name %></h3><p><%= s.role %></p><small><%= s.company %> · <%= s.country %></small></article><% }) %></div></section>
<% } else if(block.type==='projects'){ %><section class="section feature" id="projects"><div class="section-head"><h2><%= d.title %></h2></div><div class="feature-card"><div class="feature-image" style="<%= projects[0]&&projects[0].image?`background-image:url('${projects[0].image}')`:'' %>"><% if(!projects[0]||!projects[0].image){ %><span>SPECIAL PROJECT</span><% } %></div><div class="feature-copy"><div class="eyebrow"><%= projects[0]?.category||'SPECIAL PROJECT' %></div><h3><%= projects[0]?.title||'Silk Reimagined' %></h3><p><%= projects[0]?.description||'' %></p><a class="text-link" href="<%= projects[0]?.link||'#' %>">Подробнее →</a><div class="counter">01 / <%= String(projects.length).padStart(2,'0') %> →</div></div></div></section>
<% } else if(block.type==='activations'){ %><section class="section feature" id="activations"><div class="section-head"><h2><%= d.title %></h2></div><div class="feature-card reverse"><div class="feature-image" style="<%= activations[0]&&activations[0].image?`background-image:url('${activations[0].image}')`:'' %>"><% if(!activations[0]||!activations[0].image){ %><span>CITY ACTIVATION</span><% } %></div><div class="feature-copy"><div class="eyebrow"><%= activations[0]?.date||'' %> · <%= activations[0]?.time||'' %></div><h3><%= activations[0]?.title||'Город как галерея' %></h3><p><%= activations[0]?.description||'' %></p><small><%= activations[0]?.location||'' %></small><div class="counter">01 / <%= String(activations.length).padStart(2,'0') %> →</div></div></div></section>
<% } else if(block.type==='map'){ %><section class="section map-section" id="map"><div class="section-head"><h2><%= d.title %></h2><p><%= d.intro %></p></div><div class="map-wrap"><div class="map-canvas" style="<%= d.image?`background-image:url('${d.image}')`:'' %>"><% if(!d.image){ %><div class="map-lines"></div><div class="map-title">TASHKENT<br><span>DESIGN WEEK</span></div><% } %><% locations.forEach((l,i)=>{ %><a class="pin" style="left:<%= l.x %>%;top:<%= l.y %>%" href="<%= l.link||'#' %>" title="<%= l.name %>"><%= i+1 %></a><% }) %></div><div class="location-list"><% locations.forEach((l,i)=>{ %><div class="location-item"><b><%= i+1 %></b><div><strong><%= l.name %></strong><span><%= l.type %> · <%= l.address %></span></div></div><% }) %></div></div></section>
<% } else if(block.type==='registration'){ %><section class="registration" id="registration"><div class="registration-inner"><div><div class="eyebrow">TASHKENT DESIGN WEEK</div><h2><%= d.title %></h2><p><%= d.description %></p></div><form action="/register" method="post" class="reg-form"><input name="first_name" placeholder="Имя *" required><input name="last_name" placeholder="Фамилия"><input name="phone" placeholder="Телефон *" required><input type="email" name="email" placeholder="Email *" required><input name="company" placeholder="Компания"><input name="role" placeholder="Должность"><select name="interest"><option value="">Интересующее направление</option><option>Архитектура</option><option>Предметный дизайн</option><option>Интерьеры</option><option>Городская среда</option><option>Материалы и технологии</option></select><label class="consent"><input type="checkbox" name="consent" value="1" required> Я согласен на обработку персональных данных</label><button class="button light" type="submit"><%= d.button %> ↗</button></form></div></section>
<% } else if(block.type==='footer'){ %><footer class="footer"><div><b><%= settings.siteTitle %></b><p><%= d.copyright %></p></div><div class="footer-links"><a href="<%= d.instagram %>">Instagram</a><a href="<%= d.facebook %>">Facebook</a><a href="<%= d.youtube %>">YouTube</a><a href="mailto:<%= d.email %>"><%= d.email %></a></div></footer>
<% } else if(block.type==='text'){ %><section class="section generic"><div class="section-head"><h2><%= block.title %></h2></div><div class="rich"><%- d.html %></div></section>
<% } else if(block.type==='image'){ %><section class="section generic"><img class="full-image" src="<%= d.image %>" alt="<%= d.caption||'' %>"><p class="caption"><%= d.caption||'' %></p></section>
<% } else if(block.type==='cta'){ %><section class="section cta"><h2><%= block.title %></h2><p><%= d.description %></p><a class="button" href="<%= d.link %>"><%= d.button %> ↗</a></section><% } %>
<% }) %>
</main><script src="/site.js"></script></body></html>
